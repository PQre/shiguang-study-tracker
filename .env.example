# 复制为 .env，填写自己的服务信息。此文件由后端读取，勿放入frontend或GitHub Pages。
# 使用支持图片输入的模型，以及兼容Chat Completions的接口。
TRACKER_AI_BASE_URL=https://your-provider.example/v1
TRACKER_AI_MODEL=your-vision-model
TRACKER_AI_API_KEY=

# 对外提供AI服务时必须设置访问口令，在网页“AI助理→设置”输入同一口令。
# 访问口令与上面的模型API密钥不同。可用 python -c "import secrets;print(secrets.token_urlsafe(32))" 生成。
TRACKER_AI_ACCESS_TOKEN=
TRACKER_AI_ALLOWED_ORIGINS=https://pqre.github.io

# 默认兼容JSON对象模式；提供商支持严格结构化输出时可改为json_schema。
# 不支持response_format参数的接口可设为none，后端仍会校验返回内容。
TRACKER_AI_RESPONSE_FORMAT=json_object
